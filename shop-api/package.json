{
  "name": "shop-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-style Express + MongoDB commerce API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --import @pulse/sdk/register src/server.js",
    "start": "node --import @pulse/sdk/register src/server.js",
    "seed": "node src/scripts/seed.js",
    "test:auth": "node src/test/auth.js",
    "test:categories": "node src/test/categories.js",
    "test:products": "node src/test/products.js",
    "test:cart": "node src/test/cart.js",
    "test:checkout": "node src/test/checkout.js",
    "test:orders": "node src/test/orders.js",
    "test:data": "node src/test/auth.js && node src/test/categories.js && node src/test/products.js && node src/test/cart.js && node src/test/checkout.js && node src/test/orders.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pulse/sdk": "file:../pulse/sdk",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.0",
    "slugify": "^1.6.6",
    "zod": "^3.24.2"
  }
}
