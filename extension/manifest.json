{
  "manifest_version": 3,
  "name": "Ask AI",
  "version": "1.3",
  "description": "Silently fetch LinkedIn jobs, hiring posts, and profiles in chat — without using the LinkedIn search bar.",
  "action": {
    "default_title": "Ask AI"
  },
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
